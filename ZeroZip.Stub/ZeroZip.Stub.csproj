<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- SFX stub publish profile: one compact self-contained-free single file. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <AssemblyName>ZeroZip.Stub</AssemblyName>
    <ApplicationIcon>..\assets\ZeroZip.ico</ApplicationIcon>
  </PropertyGroup>



  <ItemGroup>
    <ProjectReference Include="..\ZeroZip.Core\ZeroZip.Core.csproj" />
    <ProjectReference Include="..\..\..\ZeroPlatform\ZeroUI\src\ZeroUI.Core\ZeroUI.Core.csproj" />
    <ProjectReference Include="..\..\..\ZeroPlatform\ZeroUI\src\ZeroUI.WinForms\ZeroUI.WinForms.csproj" />
  </ItemGroup>

</Project>
