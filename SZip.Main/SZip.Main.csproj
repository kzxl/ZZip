<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SZip</AssemblyName>

    <!-- Where the prebuilt stub gets published before being embedded. -->
    <StubPublishDir>$(IntermediateOutputPath)stub\</StubPublishDir>
    <StubExePath>$(StubPublishDir)SZip.Stub.exe</StubExePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ZstdSharp.Port" Version="0.8.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SZip.Core\SZip.Core.csproj" />
    <!-- Build dependency only: we publish the stub ourselves, don't reference its assembly. -->
    <ProjectReference Include="..\SZip.Stub\SZip.Stub.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <!--
    Embed the prebuilt extractor stub as the "SZip.SfxStub" resource. Declared statically so
    MSBuild assigns the LogicalName during resource-name prep; the file itself is produced by
    the PublishStub target before compilation.
  -->
  <ItemGroup>
    <EmbeddedResource Include="$(StubExePath)">
      <LogicalName>SZip.SfxStub</LogicalName>
      <Visible>false</Visible>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Publish the extractor stub as a single-file executable before this app compiles. -->
  <Target Name="PublishStub" BeforeTargets="BeforeCompile;CoreCompile"
          Inputs="@(Compile);..\SZip.Stub\SZip.Stub.csproj;..\SZip.Core\SZip.Core.csproj"
          Outputs="$(StubExePath)">
    <Message Importance="high" Text="SZip: publishing extractor stub -> $(StubExePath)" />
    <Exec Command="dotnet publish &quot;$(MSBuildProjectDirectory)\..\SZip.Stub\SZip.Stub.csproj&quot; -c $(Configuration) -r win-x64 --self-contained false -p:PublishSingleFile=true -o &quot;$(MSBuildProjectDirectory)\$(StubPublishDir)&quot;"
          ContinueOnError="false" />
    <Error Condition="!Exists('$(StubExePath)')" Text="SZip: stub publish failed, $(StubExePath) not found." />
  </Target>

</Project>
