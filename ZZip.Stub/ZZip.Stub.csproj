<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- SFX stub publish profile: one compact self-contained-free single file. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <AssemblyName>ZZip.Stub</AssemblyName>
    <ApplicationIcon>..\assets\ZZip.ico</ApplicationIcon>
  </PropertyGroup>



  <ItemGroup>
    <ProjectReference Include="..\ZZip.Core\ZZip.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ZeroUI.Core" Version="1.8.0" />
    <PackageReference Include="ZeroUI.WinForms" Version="1.8.0" />
  </ItemGroup>

</Project>
