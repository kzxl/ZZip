<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ZZip</AssemblyName>
    <ApplicationIcon>..\assets\ZZip.ico</ApplicationIcon>

    <!-- Where the prebuilt stub gets published before being embedded. -->
    <StubPublishDir>$(IntermediateOutputPath)stub\</StubPublishDir>
    <StubExePath>$(StubPublishDir)ZZip.Stub.exe</StubExePath>
  </PropertyGroup>



  <ItemGroup>
    <ProjectReference Include="..\ZZip.Core\ZZip.Core.csproj" />
    <ProjectReference Include="..\ZZip.Localization\ZZip.Localization.csproj" />
    <!-- Build dependency only: we publish the stub ourselves, don't reference its assembly. -->
    <ProjectReference Include="..\ZZip.Stub\ZZip.Stub.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ZeroUI.Core" Version="1.9.0" />
    <PackageReference Include="ZeroUI.WinForms" Version="1.9.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="languages\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!--
    Embed the prebuilt extractor stub as the "ZZip.SfxStub" resource. Declared statically so
    MSBuild assigns the LogicalName during resource-name prep; the file itself is produced by
    the PublishStub target before compilation.
  -->
  <ItemGroup>
    <EmbeddedResource Include="$(StubExePath)">
      <LogicalName>ZZip.SfxStub</LogicalName>
      <Visible>false</Visible>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Publish the extractor stub as a single-file executable before this app compiles. -->
  <Target Name="PublishStub" BeforeTargets="BeforeCompile;CoreCompile"
          Inputs="@(Compile);..\ZZip.Stub\ZZip.Stub.csproj;..\ZZip.Core\ZZip.Core.csproj"
          Outputs="$(StubExePath)">
    <Message Importance="high" Text="ZZip: publishing extractor stub -> $(StubExePath)" />
    <Exec Command="dotnet publish &quot;$(MSBuildProjectDirectory)\..\ZZip.Stub\ZZip.Stub.csproj&quot; -c $(Configuration) -r win-x64 --self-contained false -p:PublishSingleFile=true -o &quot;$(MSBuildProjectDirectory)\$(StubPublishDir)&quot;"
          ContinueOnError="false" />
    <Error Condition="!Exists('$(StubExePath)')" Text="ZZip: stub publish failed, $(StubExePath) not found." />
  </Target>

</Project>
