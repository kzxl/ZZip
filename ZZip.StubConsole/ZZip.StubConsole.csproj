<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ZZip.Stub</AssemblyName>

    <!-- Cross-platform self-extracting stub: framework-dependent single file. -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <ApplicationIcon>..\assets\ZZip.ico</ApplicationIcon>
  </PropertyGroup>



  <ItemGroup>
    <ProjectReference Include="..\ZZip.Core\ZZip.Core.csproj" />
  </ItemGroup>

</Project>
