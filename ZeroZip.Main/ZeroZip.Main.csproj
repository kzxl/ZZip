<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ZeroZip</AssemblyName>
    <ApplicationIcon>..\assets\ZeroZip.ico</ApplicationIcon>

    <!-- Where the prebuilt stub gets published before being embedded. -->
    <StubPublishDir>$(IntermediateOutputPath)stub\</StubPublishDir>
    <StubExePath>$(StubPublishDir)ZeroZip.Stub.exe</StubExePath>
  </PropertyGroup>



  <ItemGroup>
    <ProjectReference Include="..\ZeroZip.Core\ZeroZip.Core.csproj" />
    <ProjectReference Include="..\..\..\ZeroPlatform\ZeroUI\src\ZeroUI.Core\ZeroUI.Core.csproj" />
    <ProjectReference Include="..\..\..\ZeroPlatform\ZeroUI\src\ZeroUI.WinForms\ZeroUI.WinForms.csproj" />
    <!-- Build dependency only: we publish the stub ourselves, don't reference its assembly. -->
    <ProjectReference Include="..\ZeroZip.Stub\ZeroZip.Stub.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <!--
    Embed the prebuilt extractor stub as the "ZeroZip.SfxStub" resource. Declared statically so
    MSBuild assigns the LogicalName during resource-name prep; the file itself is produced by
    the PublishStub target before compilation.
  -->
  <ItemGroup>
    <EmbeddedResource Include="$(StubExePath)">
      <LogicalName>ZeroZip.SfxStub</LogicalName>
      <Visible>false</Visible>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Publish the extractor stub as a single-file executable before this app compiles. -->
  <Target Name="PublishStub" BeforeTargets="BeforeCompile;CoreCompile"
          Inputs="@(Compile);..\ZeroZip.Stub\ZeroZip.Stub.csproj;..\ZeroZip.Core\ZeroZip.Core.csproj"
          Outputs="$(StubExePath)">
    <Message Importance="high" Text="ZeroZip: publishing extractor stub -> $(StubExePath)" />
    <Exec Command="dotnet publish &quot;$(MSBuildProjectDirectory)\..\ZeroZip.Stub\ZeroZip.Stub.csproj&quot; -c $(Configuration) -r win-x64 --self-contained false -p:PublishSingleFile=true -o &quot;$(MSBuildProjectDirectory)\$(StubPublishDir)&quot;"
          ContinueOnError="false" />
    <Error Condition="!Exists('$(StubExePath)')" Text="ZeroZip: stub publish failed, $(StubExePath) not found." />
  </Target>

</Project>
